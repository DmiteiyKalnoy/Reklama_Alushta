/*
  Cache-Control: no-cache

/assets/*.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=3600

/assets/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

/assets/*.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=31536000, immutable
